[Unit]
Description=Kovanica mainnet validator (seed%i)
Documentation=https://github.com/KovanicaDAG/kovanica-protocol
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root

# Non-secret network configuration. Install to /etc/kovanica/ at mode 0600.
# Contains no KOVANICA_TREASURY_SEED; that secret lives in the file below.
EnvironmentFile=/etc/kovanica/mainnet-seed%i.env

# Treasury seed from the key ceremony. Mode 0600, never committed.
# Mainnet refuses to boot without it — it will not fall back to the
# publicly derivable placeholder.
EnvironmentFile=/etc/kovanica/mainnet-treasury.env

# Public authority set. Identical on every node; they must all agree.
EnvironmentFile=/etc/kovanica/mainnet-authorities.conf

# This seed's signing key. Mode 0600, never committed, never inlined here.
EnvironmentFile=/etc/kovanica/mainnet-authority-%i.env

# The HTTP address is a CLI argument, not an env var. Loopback only.
ExecStart=/usr/local/bin/kovanica-node explorer 127.0.0.1:3002

Restart=always
RestartSec=30
LimitNOFILE=65536
MemoryMax=6G

[Install]
WantedBy=multi-user.target