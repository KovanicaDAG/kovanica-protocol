# Kovanica testnet — seed1 (genesis / primary validator)
#
# Install to /etc/kovanica/testnet-seed1.env, mode 0600.
# Reference from systemd with EnvironmentFile=. Do not inline into a unit file.
#
# The node reads its HTTP address from the `explorer` CLI argument, not from
# an env var. Block production under PoA is KOVANICA_PRODUCE, not KOVANICA_MINE.

KOVANICA_NETWORK=kovanica-testnet
KOVANICA_CONSENSUS=poa

# P2P. Plaintext TCP only. Testnet uses port 8000, mainnet 9000, so the two
# networks coexist on one host without colliding. Each seed is on its own host,
# so all three bind the same port within a network.
#
# Peers: this seed dials the OTHER TWO seeds, never itself. Naming all three
# hosts as peers on every node makes every node dial seed1 first, which turns
# seed1 into a hard chokepoint and makes an eclipse against it trivial.
# These are DNS-only grey-cloud hostnames resolving to origin IPs; never point
# a peer at a Cloudflare orange-cloud explorer hostname on TCP.
KOVANICA_LISTEN=0.0.0.0:8000
KOVANICA_PEERS=seed2.kovanica.online:8000,seed3.kovanica.online:8000

# Chain data. Preserve this directory after the first genesis write.
KOVANICA_DATA=/var/lib/kovanica-testnet-seed1

# PoA block production. seed1 is a primary validator.
KOVANICA_PRODUCE=1
KOVANICA_PRODUCE_SECS=3

# Operator surface stays off on a public seed.
KOVANICA_OPERATOR=0

# Testnet only. Mainnet must be 0.
#
# A faucet on a publicly-reachable host hands out 5 KVNC per address to anyone
# who asks. That is the intent on testnet and is exactly why the same value
# must never appear in a mainnet env file.
#
# KOVANICA_ISOLATED_HOST is an OPERATOR ATTESTATION, not a node setting. The
# binary does not read it -- it exists so the deploy linter (and a human
# reviewing the file) can see that the faucet decision was made deliberately.
# Setting it changes nothing about how the node runs.
KOVANICA_ISOLATED_HOST=1
KOVANICA_FAUCET=1

# Hard rule: 0 at all times once genesis is written. Set to 1 only for the
# one-time genesis boot of this seed, then set it back and restart.
KOVANICA_ALLOW_RESET=0

# Metrics on loopback only; scraped, never exposed publicly. Port 9090 for
# testnet, 9091 for mainnet: both networks run on every host, and a metrics
# bind failure is NON-FATAL (the node logs to stderr and keeps running), so
# sharing one port would silently leave one network unscrapeable.
KOVANICA_METRICS_LISTEN=127.0.0.1:9090

# ---------------------------------------------------------------------------
# Pruning and finality depths are NOT configurable here.
#
# KOVANICA_FINALITY_DEPTH / KOVANICA_PAYLOAD_PRUNING_DEPTH /
# KOVANICA_BLOCK_PRUNING_DEPTH are read by NO code path. They are compiled-in
# NetworkProfile constants. An earlier revision of this file set them, which
# made it look like an operator was tuning pruning and finality while the node
# silently used the built-in values.
#
# The testnet profile actually uses, from crates/kovanica-node/src/explorer.rs:
#   finality_depth         100
#   payload_pruning_depth  1_000
#   block_pruning_depth    1_000
#
# Changing any of these requires editing NetworkProfile and a chain reset.
# Do not reintroduce them here.
# ---------------------------------------------------------------------------