# Kovanica mainnet — seed2
#
# Install to /etc/kovanica/mainnet-seed2.env, mode 0600.
# Reference from systemd with EnvironmentFile=. Do not inline into a unit file.
#
# The node reads its HTTP address from the `explorer` CLI argument, not from
# an env var. Block production under PoA is KOVANICA_PRODUCE, not KOVANICA_MINE.
#
# TWO SECRETS ARE REQUIRED AND ARE NOT IN THIS FILE:
#   KOVANICA_TREASURY_SEED  64-hex treasury seed from the key ceremony.
#   KOVANICA_AUTHORITY_KEY  this seed's signing key, in authority-2.env.
# Keep both out of git. authority-2.env is loaded as a separate
# EnvironmentFile=, never merged into this one.

KOVANICA_NETWORK=kovanica-mainnet
KOVANICA_CONSENSUS=poa

# Mainnet boots dormant. Required, but not a licence to run before the
# mainnet NetworkProfile parameters are ratified.
KOVANICA_MAINNET_OVERRIDE=1

# P2P. Plaintext TCP only. Testnet uses port 8000, mainnet 9000, so the two
# networks coexist on one host without colliding. Each seed is on its own host,
# so all three bind the same port within a network.
#
# Peers: this seed dials the OTHER TWO seeds, never itself. Naming all three
# hosts as peers on every node makes every node dial seed1 first, which turns
# seed1 into a hard chokepoint and makes an eclipse against it trivial.
# These are DNS-only grey-cloud hostnames resolving to origin IPs; never point
# a peer at a Cloudflare orange-cloud explorer hostname on TCP.
KOVANICA_LISTEN=0.0.0.0:9000
KOVANICA_PEERS=seed.kovanica.online:9000,seed3.kovanica.online:9000

# Chain data. Preserve this directory after the first genesis write.
KOVANICA_DATA=/var/lib/kovanica-mainnet-seed2

# PoA block production.
KOVANICA_PRODUCE=1
KOVANICA_PRODUCE_SECS=3

# Operator surface stays off on a public seed.
KOVANICA_OPERATOR=0

# Hard rule on mainnet: no faucet, ever.
KOVANICA_FAUCET=0

# Hard rule: 0 at all times once genesis is written.
KOVANICA_ALLOW_RESET=0

# Metrics on loopback only. Port 9091 for mainnet, 9090 for testnet: both networks
# run on every host, and a metrics bind failure is NON-FATAL (the node logs
# to stderr and keeps running), so sharing one port would silently leave one
# network unscrapeable. Prompts/9090 belongs to the testnet node.
KOVANICA_METRICS_LISTEN=127.0.0.1:9091

# ---------------------------------------------------------------------------
# Pruning and finality depths are NOT configurable here.
#
# KOVANICA_FINALITY_DEPTH / KOVANICA_PAYLOAD_PRUNING_DEPTH /
# KOVANICA_BLOCK_PRUNING_DEPTH are read by NO code path. They are compiled-in
# NetworkProfile constants.
#
# NOTE: an earlier revision of this file set FINALITY_DEPTH=100, which was both
# ignored AND wrong. The mainnet profile does not use testnet's depths. From
# crates/kovanica-node/src/explorer.rs (NetworkProfile::mainnet):
#   finality_depth         1_000
#   payload_pruning_depth  10_000
#   block_pruning_depth    10_000
#
# This is worth stating plainly: mainnet prunes 10x more aggressively than
# testnet. An operator who believed the config file set finality to 100 would
# have been wrong about the live mainnet profile by an order of magnitude.
#
# Changing any of these requires editing NetworkProfile and a chain reset.
# Do not reintroduce them here.
# ---------------------------------------------------------------------------