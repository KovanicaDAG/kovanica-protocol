# Kovanica mainnet — seed1
#
# Install to /etc/kovanica/mainnet-seed1.env, mode 0600.
# Reference from systemd with EnvironmentFile=. Do not inline into a unit file.
#
# The node reads its HTTP address from the `explorer` CLI argument, not from
# an env var. Block production under PoA is KOVANICA_PRODUCE, not KOVANICA_MINE.
#
# TWO SECRETS ARE REQUIRED AND ARE NOT IN THIS FILE:
#   KOVANICA_TREASURY_SEED  64-hex treasury seed from the key ceremony.
#                         Mainnet refuses to boot with the publicly derivable
#                         placeholder, so this is mandatory (explorer.rs).
#   KOVANICA_AUTHORITY_KEY  this seed's signing key, in authority-1.env.
# Keep both out of git. The authority-1.env file is loaded as a separate
# EnvironmentFile=, never merged into this one.

KOVANICA_NETWORK=kovanica-mainnet
KOVANICA_CONSENSUS=poa

# Mainnet boots dormant. This override is the deliberate gate that stops a
# mainnet node from starting on placeholder consensus parameters. It is
# required, but it is not a licence to run mainnet before the parameters in
# the mainnet NetworkProfile are ratified.
KOVANICA_MAINNET_OVERRIDE=1

# P2P. Plaintext TCP only, port 9000 for mainnet across all three seeds.
KOVANICA_LISTEN=0.0.0.0:9000
KOVANICA_PEERS=seed.kovanica.online:9000

# Chain data. Preserve this directory after the first genesis write.
KOVANICA_DATA=/var/lib/kovanica-mainnet-seed1

# PoA block production.
KOVANICA_PRODUCE=1
KOVANICA_PRODUCE_SECS=3

# Operator surface stays off on a public seed.
KOVANICA_OPERATOR=0

# Hard rule on mainnet: no faucet, ever.
KOVANICA_FAUCET=0

# Hard rule: 0 at all times once genesis is written.
KOVANICA_ALLOW_RESET=0

# Metrics on loopback only.
KOVANICA_METRICS_LISTEN=127.0.0.1:9090

# Pruning / finality depths. Consensus-visible; do not diverge across seeds.
KOVANICA_PAYLOAD_PRUNING_DEPTH=1000
KOVANICA_BLOCK_PRUNING_DEPTH=1000
KOVANICA_FINALITY_DEPTH=100