# Kovanica Mainnet Configuration
# Network ID: kovanica
# Consensus: PoA-only (RFC-POA-Migration ratified 2026-09-25)
# Status: DORMANT — requires KOVANICA_MAINNET_OVERRIDE=1 to boot
#
# WARNING: Mainnet refuses to boot without:
#   1. KOVANICA_AUTHORITIES (comma-separated 64-hex Ed25519 public keys)
#   2. KOVANICA_TREASURY_SEED (64-hex)
#   3. KOVANICA_MAINNET_OVERRIDE=1
#
# This file is a TEMPLATE. The two required secrets above are intentionally
# left unset — never commit them.

KOVANICA_NETWORK=mainnet
KOVANICA_MAINNET_OVERRIDE=1
KOVANICA_LISTEN=0.0.0.0:9001
KOVANICA_PEERS=seed.kovanica.online:9000,seed2.kovanica.online:9000

# Consensus: PoA-only
KOVANICA_CONSENSUS=poa

# Authority set — REQUIRED for mainnet
# KOVANICA_AUTHORITIES=

# Treasury seed — REQUIRED for mainnet
# KOVANICA_TREASURY_SEED=

# Slot duration (PoA fixed slot, milliseconds).
# NOTE: the old KOVANICA_SLOT_DURATION_MS was never read by any binary —
# this file silently ran on the 3000 ms built-in default. Renamed to the
# name the code actually reads (explorer.rs, poa_config_from_env).
KOVANICA_SLOT_DURATION=3000

# Node operation
KOVANICA_OPERATOR=1
KOVANICA_MINE=0
KOVANICA_MINE_SECS=60
KOVANICA_FAUCET=0
KOVANICA_ALLOW_RESET=0
KOVANICA_DATA=/opt/kovanica/mainnet/data

# Prometheus scrape endpoint. Bound to loopback on purpose: the node's own
# source comment warns that the 0.0.0.0 default "exposes the scrape endpoint
# on every interface". Set to `off`/`none`/`0`/`disabled` to disable metrics.
# NOTE: the old KOVANICA_METRICS_PORT was never read by any binary.
KOVANICA_METRICS_LISTEN=127.0.0.1:9091

# ---------------------------------------------------------------------------
# RFC-006 parameters are NOT configurable.
#
# The following were listed here but are read by NO code path, so setting
# them did nothing while looking authoritative:
#   KOVANICA_K, KOVANICA_FINALITY_DEPTH, KOVANICA_PRUNING_DEPTH,
#   KOVANICA_MAX_SUPPLY, KOVANICA_COINBASE_MATURITY, KOVANICA_SUBSIDY,
#   KOVANICA_FOUNDER_AMOUNT, KOVANICA_FOUNDER_SEED, KOVANICA_MIN_FEE,
#   KOVANICA_ATOM, KOVANICA_POW, KOVANICA_POA_NOMINAL_WORK,
#   KOVANICA_NETWORK_ID, KOVANICA_EXPLORER_PORT
#
# They are compiled-in consensus constants and must stay that way:
#   MAX_SUPPLY           90_200_000 KVNC  (ledger.rs, enforced in apply_block)
#   COINBASE_MATURITY    100 blocks
#   genesis_k            3 (GHOSTDAG)
#   fee burn             75% burned / 25% producer
#   genesis subsidy      10 KVNC, geometric decay x3/4 per 2_000_000-block era
#
# Do not reintroduce them here. Changing any of these requires a ratified RFC
# and a chain reset, which is out of scope for configuration.
#
# This was not cosmetic: KOVANICA_PRUNING_DEPTH=2000 was set here, but the
# mainnet profile hardcodes 10_000 — an operator would have believed they had
# tuned pruning and silently had not.
# ---------------------------------------------------------------------------
