# Kovanica Devnet Configuration
# Network ID: kovanica-devnet
# Consensus: PoA-only (RFC-POA-Migration ratified 2026-09-25)
# Status: Local development network
#
# Ports: P2P 9002, Explorer 8082, Metrics 9092
#
# ─────────────────────────────────────────────────────────────────────────────
# This file is a node BOOT CONFIG, not a consensus-parameter file.
#
# Every RFC-006 parameter below (K, MAX_SUPPLY, COINBASE_MATURITY, SUBSIDY,
# MIN_FEE, ATOM, FINALITY_DEPTH, PRUNING_DEPTH) is a Rust constant compiled into
# the binary via NetworkProfile — NOT an env var. An earlier revision of this
# file listed them, which made it look like they were configurable here; they
# were silently ignored. Editing them changed nothing.
#
# Devnet deliberately uses the SAME economics and finality as testnet
# (`NetworkProfile::devnet`), so a clean devnet run is real evidence about
# production. Devnet differs only in isolation: its own data directory, its own
# P2P port, and no default seeds.
#
# Verified against the built binary: the env vars the node actually reads are
# KOVANICA_NETWORK, KOVANICA_DATA, KOVANICA_LISTEN, KOVANICA_PEERS,
# KOVANICA_SLOT_DURATION, KOVANICA_PRODUCE_SECS, KOVANICA_MINE,
# KOVANICA_MINE_SECS, KOVANICA_FAUCET, KOVANICA_OPERATOR, KOVANICA_ALLOW_RESET,
# KOVANICA_AUTHORITIES, KOVANICA_AUTHORITY_THRESHOLD, KOVANICA_AUTHORITY_KEY,
# KOVANICA_CONSENSUS, KOVANICA_METRICS_LISTEN, KOVANICA_TREASURY_SEED.
# ─────────────────────────────────────────────────────────────────────────────

# Selects the devnet profile. Unrecognised values now PANIC rather than
# silently falling back to the public testnet (which is how a container
# labelled "devnet" used to become a real testnet node).
KOVANICA_NETWORK=devnet

# Loopback: not reachable from outside the host unless you widen it.
KOVANICA_LISTEN=127.0.0.1:9002

# Empty = no bootstrap peers. Devnet has NO default seeds by design; it must
# never dial seed.kovanica.online. In a compose network, set this to the
# in-network peer list (e.g. devnet-1:9002) explicitly.
KOVANICA_PEERS=

# Own data directory — separate from the testnet's, so the network-marker
# wipe in ensure_network can never cross the boundary.
KOVANICA_DATA=/opt/kovanica/devnet/data

# Metrics scrape bind. Note the exact name: KOVANICA_METRICS_LISTEN, not
# KOVANICA_METRICS_PORT. The old name was silently ignored.
KOVANICA_METRICS_LISTEN=127.0.0.1:9092

# PoA fixed slot (RFC-POA). Name is KOVANICA_SLOT_DURATION, not
# KOVANICA_SLOT_DURATION_MS — the old name was silently ignored and the
# node fell back to its default.
KOVANICA_SLOT_DURATION=3000

# Node operation
KOVANICA_OPERATOR=1
KOVANICA_MINE=1
KOVANICA_MINE_SECS=10

# Faucet: fine on an isolated devnet, and the reason it is on here at all.
# NEVER set this on a publicly-reachable node (see config/testnet/network.env).
KOVANICA_FAUCET=1

# Genesis reset allowed — devnet only. This is a chain-wipe switch; it must
# never be set on testnet or mainnet.
KOVANICA_ALLOW_RESET=1

# Explorer bind address. This one IS a CLI arg (`explorer <addr>`), not an
# env var: `kovanica-node explorer 127.0.0.1:8082`.
