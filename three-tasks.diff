+/// Publish RFC-006 supply metrics ([`kovanica_state::SupplyMetrics`]) and the
+/// current block subsidy to Prometheus. Call on every accepted block (mined
+/// or observed) so `kovanica_supply_*` tracks the selected chain live,
+/// mirroring the same values already exposed over `GET /api/head`.
+pub fn set_supply_metrics(total: u64, circulating: u64, burned: u64, max_supply: u64, subsidy: u64) {
+    gauge!(names::SUPPLY_TOTAL).set(total as f64);
+    gauge!(names::SUPPLY_CIRCULATING).set(circulating as f64);
+    gauge!(names::SUPPLY_BURNED).set(burned as f64);
+    gauge!(names::SUPPLY_MAX).set(max_supply as f64);
+    gauge!(names::SUPPLY_SUBSIDY).set(subsidy as f64);
+}
+
 /// A timer guard that records a histogram on drop.
 pub struct TimerGuard {
     name: &'static str,
