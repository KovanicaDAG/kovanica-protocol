From ce3d2f03826807846366cf9c961b30ed69b2d1d6 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Fri, 11 Sep 2026 22:30:35 +0000
Subject: [PATCH] fix(web): mobile nav overlap, toast position, multisig tab
 labels, pool overflow, explorer stat grid

- Shell: root container was min-h-dvh (grows with content) instead of a
  fixed viewport height, so the bottom-padding reserved for the mobile
  nav never actually applied on document-scroll pages. Changed to
  h-dvh overflow-hidden with the content wrapper as the real scroll
  container (overflow-y-auto). Fixes bottom-nav covering content on
  Home, Explorer, Docs, Pool, Roadmap, and the invisible world map on
  the Map page (same root cause).
- Toaster: top-center position collided with the sticky header on
  Network page toasts; added offset/mobileOffset below the header.
- Multisig tab switcher: labels were hidden below sm breakpoint,
  leaving three unlabeled icons on mobile. Always show labels.
- Pool: stratum URL overflowed its card on mobile (flex-1 child with
  no min-w-0). Added min-w-0.
- Explorer stat grid: lg:grid-cols-9 left a dangling row for 15 stat
  items; corrected to grid-cols-5 (15 = 5x3, no remainder).

Verified with tsc --noEmit and eslint on touched files; screenshot-
checked all 9 routes at desktop and mobile viewports before and after.
---
 web/src/components/explorer/explorer-view.tsx | 2 +-
 web/src/components/layout/shell.tsx           | 4 ++--
 web/src/components/wallet/multisig-view.tsx   | 4 ++--
 web/src/routes/__root.tsx                     | 2 ++
 web/src/routes/pool.tsx                       | 2 +-
 5 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/web/src/components/explorer/explorer-view.tsx b/web/src/components/explorer/explorer-view.tsx
index 9babf66..9723207 100644
--- a/web/src/components/explorer/explorer-view.tsx
+++ b/web/src/components/explorer/explorer-view.tsx
@@ -86,7 +86,7 @@ export function ExplorerView() {
         </div>
       </div>
 
-      <dl className="grid grid-cols-3 border-b border-border bg-border md:grid-cols-6 lg:grid-cols-9">
+      <dl className="grid grid-cols-3 border-b border-border bg-border md:grid-cols-5 lg:grid-cols-5">
         <Stat label="Blocks" value={String(n?.blocks ?? "—")} />
         <Stat label="Tips" value={String(n?.tips.length ?? "—")} />
         <Stat label="Blue score" value={String(n?.blue_score ?? "—")} />
