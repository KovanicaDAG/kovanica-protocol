{
  "name": "@kovanica/api-client",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Typed client for the Kovanica node HTTP API, generated from openapi/kovanica-node.yaml",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "openapi"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:drift": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "openapi-typescript": "^7.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  }
}
