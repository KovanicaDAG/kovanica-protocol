+++ b/web/src/lib/api/contract.ts
@@ -16,10 +16,19 @@ export const NETWORK_PROXIES: Record<PublicSource, string> = {
 export const TOKEN = "KVNC";
 export const ATOM = 100_000_000;
 export const DECIMALS = 8;
-export const SUBSIDY = 200 * ATOM;
-export const FOUNDER_AMOUNT = 200 * ATOM;
+// RFC-006: genesis subsidy 10 KVNC/block, geometric decay (alpha = 3/4) every
+// ERA_LENGTH blocks, capped growth via MAX_SUPPLY. Mirrors node's subsidy_at().
+export const SUBSIDY = 10 * ATOM;
+export const DECAY_ALPHA_NUM = 3;
+export const DECAY_ALPHA_DEN = 4;
+export const ERA_LENGTH = 2_000_000;
+/** @deprecated use ERA_LENGTH (kept for any remaining external references) */
+export const HALVING_ERA = ERA_LENGTH;
+export const MAX_SUPPLY = 90_200_000 * ATOM;
+// RFC-006 premine: 0.2M KVNC founder + 10M KVNC treasury vaults.
+export const FOUNDER_AMOUNT = 200_000 * ATOM;
 export const FOUNDER_SEED = 1;
-export const HALVING_ERA = 500_000;
+export const TREASURY_AMOUNT = 10_000_000 * ATOM;
 // Mirrors the node: min_fee = max(subsidy / 500_000, 1) atoms.
 export const MIN_FEE = Math.max(Math.floor(SUBSIDY / 500_000), 1);
 export const K = 3;
