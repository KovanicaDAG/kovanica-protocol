diff --git a/web/src/lib/ledger/engine.ts b/web/src/lib/ledger/engine.ts
index e655991..d3cd9e3 100644
--- a/web/src/lib/ledger/engine.ts
+++ b/web/src/lib/ledger/engine.ts
@@ -1,6 +1,6 @@
 import { hashHex } from "./hash";
-import { HALVING_ERA } from "../api/contract";
-import { ATOM, K, SUBSIDY, type Block, type Colour, type Tx } from "./types";
+import { DECAY_ALPHA_DEN, DECAY_ALPHA_NUM, ERA_LENGTH } from "../api/contract";
+import { K, SUBSIDY, type Block, type Colour, type Tx } from "./types";
 
 const TREASURY = "cecc1507dc1ddd7295951c290888f095adb9044d1b73d696e6df065d683bd4fc";
 
@@ -147,9 +147,15 @@ function heaviest(blocks: Block[], ids: string[]): string {
   return selectedTip(candidates);
 }
 
+// RFC-006: geometric decay, subsidy *= (3/4) per ERA_LENGTH-block era.
+// Capped at 256 eras (mirrors the node) so the loop can't run unbounded.
 export function subsidyAt(height: number): number {
-  const era = Math.floor(height / HALVING_ERA);
-  return Math.max(ATOM, SUBSIDY / 2 ** era);
+  const era = Math.min(Math.floor(height / ERA_LENGTH), 256);
+  let s = SUBSIDY;
+  for (let i = 0; i < era; i++) {
+    s = Math.floor((s * DECAY_ALPHA_NUM) / DECAY_ALPHA_DEN);
+  }
+  return Math.max(0, s);
 }
 
 export function supplyOf(blocks: Block[]): number {
