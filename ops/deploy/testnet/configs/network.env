# Kovanica TESTNET network environment (sourceable)
#
# Superseded by the per-seed files in this directory:
#   seed1.env / seed2.env / seed3.env
# Those are what systemd loads via EnvironmentFile=. Prefer them.
#
# Kept for interactive use:  set -a; . ./network.env; set +a
#
# DO NOT set KOVANICA_NETWORK_ID. The node reads KOVANICA_NETWORK. The _ID
# spelling is read by nothing, so a file that used it left the node on its
# DEFAULT profile -- which is the public testnet. That failure is silent: a
# mainnet config written with the wrong name boots a real testnet node and
# dials the public seeds.

export KOVANICA_NETWORK=kovanica-testnet
# No KOVANICA_CONSENSUS. No code path reads it: PoA is what the node does when
# the variable is unset, so setting it changed nothing while reading as though
# admission were operator-configurable. Consensus is compiled in.
export KOVANICA_LISTEN=0.0.0.0:8000
export KOVANICA_PEERS=seed.kovanica.online:8000,seed2.kovanica.online:8000,seed3.kovanica.online:8000
# No default KOVANICA_DATA here on purpose. Point this at the seed's own
# directory before starting a node, e.g.
#   export KOVANICA_DATA=/var/lib/kovanica-testnet-seed1
# A sourceable file that shipped a default data path would let a
# forgotten variable point a node at another seed's chain state.
export KOVANICA_ALLOW_RESET=0
export KOVANICA_OPERATOR=0
export KOVANICA_FAUCET=1
export KOVANICA_ISOLATED_HOST=1
